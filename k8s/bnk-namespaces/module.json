{
  "module": {
    "name": "BNK Namespaces",
    "path": "k8s/bnk-namespaces",
    "version": "1.0.0",
    "layer": "kubernetes",
    "category": "setup",
    "description": "Creates required namespaces for F5 BNK deployment: f5-bnk (core components), f5-utils (utilities), and gateway namespace (Gateway API resources). Per F5 CloudDocs, these namespaces are standard for BNK 2.2 deployments.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [],
    "optional": []
  },
  "inputs": {
    "required": [],
    "optional": [
      {
        "name": "bnk_namespace",
        "type": "string",
        "description": "Namespace for core BNK components (FLO, CWC, TMM)",
        "default": "f5-bnk",
        "source": "user"
      },
      {
        "name": "utils_namespace",
        "type": "string",
        "description": "Namespace for BNK utility components (IPAM, observability)",
        "default": "f5-utils",
        "source": "user"
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace for Gateway API resources",
        "default": "gateway-ns",
        "source": "user"
      },
      {
        "name": "create_gateway_namespace",
        "type": "boolean",
        "description": "Whether to create the gateway namespace",
        "default": true,
        "source": "user"
      },
      {
        "name": "create_far_secrets",
        "type": "boolean",
        "description": "Whether to create FAR image pull secrets in namespaces",
        "default": false,
        "source": "user"
      },
      {
        "name": "far_secret_name",
        "type": "string",
        "description": "Name of the FAR image pull secret",
        "default": "f5-far-secret",
        "source": "user"
      },
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster",
        "default": "",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "bnk_namespace",
        "type": "string",
        "description": "Name of the BNK core namespace",
        "used_by": ["bnk/flo", "bnk/far-setup"],
        "sensitive": false
      },
      {
        "name": "utils_namespace",
        "type": "string",
        "description": "Name of the utilities namespace",
        "used_by": ["bnk/flo"],
        "sensitive": false
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Name of the gateway namespace",
        "used_by": ["bnk/gateway", "bnk/routes", "bnk/bnk-secpolicy", "bnk/bnk-netpolicy"],
        "sensitive": false
      },
      {
        "name": "namespaces_ready",
        "type": "boolean",
        "description": "Flag indicating all namespaces are ready",
        "used_by": ["bnk/flo", "bnk/far-setup"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": []
  },
  "backend": {
    "recommendations": {
      "aws": "s3",
      "azure": "azurerm",
      "gcp": "gcs",
      "on-prem": "local"
    }
  },
  "deployment": {
    "order": 30,
    "estimated_time": "30 seconds",
    "requires_user_input": false,
    "sensitive_inputs": ["far_docker_config"]
  }
}
