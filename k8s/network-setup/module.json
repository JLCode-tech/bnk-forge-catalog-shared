{
  "module": {
    "name": "Network Attachment Definitions",
    "path": "k8s/network-setup",
    "version": "1.0.0",
    "layer": "kubernetes",
    "category": "networking",
    "description": "Creates Multus NetworkAttachmentDefinitions (NADs) for TMM external/internal networks. Required for BNK high-performance deployments.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      {
        "module": "k8s/bnk-namespaces",
        "reason": "NADs deployed to BNK namespace"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "namespace",
        "type": "string",
        "description": "Namespace for NADs (must match CNEInstance namespace — f5-operator)",
        "source": "module",
        "from_module": "k8s/bnk-namespaces",
        "from_output": "operator_namespace",
        "default": "f5-operator"
      },
      {
        "name": "external_subnet_cidrs",
        "type": "list(string)",
        "description": "External subnet CIDRs from VPC",
        "source": "module",
        "from_module": "infra/aws/vpc",
        "from_output": "private_external_subnet_cidrs",
        "default": ["10.0.10.0/24", "10.0.11.0/24"]
      },
      {
        "name": "internal_subnet_cidrs",
        "type": "list(string)",
        "description": "Internal subnet CIDRs from VPC",
        "source": "module",
        "from_module": "infra/aws/vpc",
        "from_output": "private_internal_subnet_cidrs",
        "default": ["10.0.20.0/24", "10.0.21.0/24"]
      }
    ],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster",
        "default": "",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "external_nad_name",
        "type": "string",
        "description": "Name of external NAD",
        "used_by": ["bnk/bnk-gatewayclass"],
        "sensitive": false
      },
      {
        "name": "internal_nad_name",
        "type": "string",
        "description": "Name of internal NAD",
        "used_by": ["bnk/bnk-gatewayclass"],
        "sensitive": false
      },
      {
        "name": "nads_ready",
        "type": "boolean",
        "description": "Flag indicating NADs are ready",
        "used_by": ["bnk/bnk-gatewayclass"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": []
  },
  "deployment": {
    "order": 31,
    "estimated_time": "1 minute",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
