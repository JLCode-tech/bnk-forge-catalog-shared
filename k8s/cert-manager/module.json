{
  "module": {
    "name": "Cert-Manager (Jetstack)",
    "path": "k8s/cert-manager",
    "version": "3.0.0",
    "layer": "kubernetes",
    "category": "security",
    "description": "Deploys Jetstack cert-manager v1.16.1 with self-signed ClusterIssuer and OTEL telemetry certs for BNK. CWC certs are auto-managed by FLO. OTEL certs replace the static Helm-embedded cert with managed auto-rotating ones.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [],
    "optional": [
      {
        "module": "k8s/bnk-namespaces",
        "reason": "BNK namespace must exist before OTEL certs can be created there"
      }
    ]
  },
  "inputs": {
    "required": [],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster",
        "default": "",
        "source": "user"
      },
      {
        "name": "namespace",
        "type": "string",
        "description": "Namespace for cert-manager",
        "default": "cert-manager",
        "source": "user"
      },
      {
        "name": "cert_manager_version",
        "type": "string",
        "description": "Jetstack cert-manager version (F5 tested v1.16.1)",
        "default": "v1.16.1",
        "source": "user"
      },
      {
        "name": "create_cluster_issuer",
        "type": "boolean",
        "description": "Create self-signed ClusterIssuer",
        "default": true,
        "source": "user"
      },
      {
        "name": "cluster_issuer_name",
        "type": "string",
        "description": "Name of the CA ClusterIssuer",
        "default": "bnk-ca-cluster-issuer",
        "source": "user"
      },
      {
        "name": "ca_certificate_name",
        "type": "string",
        "description": "Name of the CA certificate",
        "default": "bnk-ca",
        "source": "user"
      },
      {
        "name": "bnk_namespace",
        "type": "string",
        "description": "Namespace where BNK components are deployed (OTEL certs created here)",
        "default": "f5-bnk",
        "source": "user"
      },
      {
        "name": "create_otel_certs",
        "type": "boolean",
        "description": "Create OTEL telemetry certificates via cert-manager (replaces static FLO Helm cert)",
        "default": true,
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "cert_manager_ready",
        "type": "boolean",
        "description": "Flag indicating cert-manager is ready",
        "used_by": ["bnk/flo"],
        "sensitive": false
      },
      {
        "name": "cluster_issuer_name",
        "type": "string",
        "description": "Name of the ClusterIssuer",
        "used_by": ["bnk/flo", "bnk/cneinstance"],
        "sensitive": false
      },
      {
        "name": "bnk_certs_ready",
        "type": "boolean",
        "description": "Flag indicating OTEL certs have been issued (CWC certs auto-managed by FLO)",
        "used_by": ["bnk/flo"],
        "sensitive": false
      },
      {
        "name": "otel_server_cert_secret_name",
        "type": "string",
        "description": "Name of the OTEL server certificate secret",
        "used_by": [],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes", "helm"],
    "optional": []
  },
  "deployment": {
    "order": 35,
    "estimated_time": "4 minutes",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
