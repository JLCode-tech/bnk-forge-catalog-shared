{
  "module": {
    "name": "BNK Routes",
    "path": "bnk/routes",
    "version": "1.0.0",
    "layer": "bnk-gateway",
    "category": "routing",
    "description": "Creates Kubernetes Gateway API Route resources (HTTPRoute, GRPCRoute, L4Route) for application traffic routing through BNK Gateway.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      {
        "module": "bnk/gateway",
        "reason": "Routes must attach to an existing Gateway"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "route_name",
        "type": "string",
        "description": "Name for the Route resource",
        "source": "user",
        "example": "my-app-route",
        "default": "default-route"
      },
      {
        "name": "route_namespace",
        "type": "string",
        "description": "Namespace for Route deployment",
        "source": "user",
        "example": "gateway-ns",
        "default": "gateway-ns"
      },
      {
        "name": "route_type",
        "type": "string",
        "description": "Type of route (HTTPRoute, GRPCRoute, L4Route)",
        "source": "user",
        "example": "HTTPRoute",
        "default": "HTTPRoute"
      },
      {
        "name": "parent_refs",
        "type": "list(object)",
        "description": "List of parent Gateways this route attaches to",
        "source": "user",
        "example": [{"name": "bnk-gateway", "namespace": "gateway-ns"}],
        "default": [{"name": "bnk-gateway", "namespace": "gateway-ns"}]
      },
      {
        "name": "rules",
        "type": "list(object)",
        "description": "Routing rules (matches, filters, backend_refs)",
        "source": "user",
        "example": [{"matches": [{"path": {"type": "PathPrefix", "value": "/"}}]}],
        "default": [{"matches": [{"path": {"type": "PathPrefix", "value": "/"}}]}]
      },
      {
        "name": "gateway_ready",
        "type": "boolean",
        "description": "Dependency flag ensuring Gateway is ready",
        "source": "module",
        "from_module": "bnk/gateway",
        "from_output": "gateway_ready"
      }
    ],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster",
        "default": "",
        "source": "user"
      },
      {
        "name": "hostnames",
        "type": "list(string)",
        "description": "Hostnames for route matching",
        "default": [],
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "route_name",
        "type": "string",
        "description": "Name of the created Route",
        "used_by": [],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": []
  },
  "deployment": {
    "order": 80,
    "estimated_time": "1 minute",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
