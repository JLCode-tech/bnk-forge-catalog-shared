{
  "module": {
    "name": "BNK GatewayClass",
    "path": "bnk/bnk-gatewayclass",
    "version": "2.0.0",
    "layer": "bnk-gateway",
    "category": "gateway",
    "description": "Creates standard Kubernetes GatewayClass (gateway.networking.k8s.io/v1) for BNK 2.2 with auto-constructed controllerName.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      {
        "module": "bnk/flo",
        "reason": "FLO provides the Gateway API controller"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "gatewayclass_name",
        "type": "string",
        "description": "Name for the GatewayClass resource",
        "source": "user",
        "example": "bnk-gatewayclass",
        "default": "bnk-gatewayclass"
      },
      {
        "name": "flo_namespace",
        "type": "string",
        "description": "Namespace where FLO is deployed",
        "source": "module",
        "from_module": "bnk/flo",
        "from_output": "flo_namespace",
        "default": "f5-bnk"
      },
      {
        "name": "flo_ready",
        "type": "boolean",
        "description": "Dependency flag ensuring FLO is ready",
        "source": "module",
        "from_module": "bnk/flo",
        "from_output": "flo_ready"
      }
    ],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster",
        "default": "",
        "source": "user"
      },
      {
        "name": "controller_name",
        "type": "string",
        "description": "Controller name for GatewayClass",
        "default": "",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "gatewayclass_name",
        "type": "string",
        "description": "Name of the created GatewayClass",
        "used_by": ["bnk/gateway"],
        "sensitive": false
      },
      {
        "name": "gatewayclass_ready",
        "type": "boolean",
        "description": "Flag indicating GatewayClass is ready",
        "used_by": ["bnk/gateway"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": []
  },
  "deployment": {
    "order": 60,
    "estimated_time": "2 minutes",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
