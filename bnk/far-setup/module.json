{
  "module": {
    "name": "F5 Artifact Registry (FAR) Setup",
    "path": "bnk/far-setup",
    "version": "2.0.0",
    "layer": "bnk-foundation",
    "category": "foundation",
    "description": "Sets up F5 Artifact Registry authentication and configures component versions for BNK 2.2 deployment. Creates image pull secrets and version configuration. Use with bnk-namespaces module for namespace creation.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      {
        "module": "k8s/bnk-namespaces",
        "outputs_used": ["bnk_namespace", "utils_namespace"]
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "bnk_manifest_version",
        "type": "string",
        "description": "BNK manifest version - select from available F5 releases",
        "source": "user",
        "example": "2.2.0-3.2226.0-0.0.385",
        "default": "2.2.0-3.2226.0-0.0.385",
        "enum_values": [
          {"label": "BNK 2.2 GA (Latest)", "value": "2.2.0-3.2226.0-0.0.385"},
          {"label": "BNK 2.1 GA", "value": "2.1.0-3.1736.1-0.1.27"}
        ],
        "validation": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-[0-9]+\\.[0-9]+\\.[0-9]+-[0-9]+\\.[0-9]+\\.[0-9]+$",
          "error_message": "Must follow format: X.Y.Z-A.B.C-D.E.F (e.g., 2.2.0-3.2226.0-0.0.385)"
        }
      },
      {
        "name": "service_account_key_file",
        "type": "string",
        "description": "Path to F5 FAR service account JSON key file inside container. Place file in ./secrets/ directory on host.",
        "source": "user",
        "example": "/app/secrets/far-credentials.json",
        "default": "/app/secrets/far-credentials.json",
        "sensitive": true,
        "validation": {
          "type": "file_path",
          "error_message": "File must exist at specified path. Place far-credentials.json in ./secrets/ directory on host."
        }
      }
    ],
    "optional": [
      {
        "name": "bnk_namespace",
        "type": "string",
        "description": "Namespace for BNK components (should match bnk-namespaces output)",
        "default": "f5-bnk",
        "source": "module",
        "source_module": "k8s/bnk-namespaces",
        "source_output": "bnk_namespace"
      },
      {
        "name": "utils_namespace",
        "type": "string",
        "description": "Namespace for utility components (should match bnk-namespaces output)",
        "default": "f5-utils",
        "source": "module",
        "source_module": "k8s/bnk-namespaces",
        "source_output": "utils_namespace"
      },
      {
        "name": "create_namespaces",
        "type": "boolean",
        "description": "Create namespaces automatically (set false if using bnk-namespaces module)",
        "default": false,
        "source": "user"
      },
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster (for resource identification)",
        "default": "",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "bnk_namespace",
        "type": "string",
        "description": "Namespace for BNK components",
        "used_by": ["bnk/flo"],
        "sensitive": false
      },
      {
        "name": "utils_namespace",
        "type": "string",
        "description": "Namespace for utility components",
        "used_by": ["bnk/flo"],
        "sensitive": false
      },
      {
        "name": "far_secret_name",
        "type": "string",
        "description": "Name of the FAR registry secret",
        "used_by": ["bnk/flo"],
        "sensitive": false
      },
      {
        "name": "flo_version",
        "type": "string",
        "description": "Version of F5 Lifecycle Operator from manifest",
        "used_by": ["bnk/flo"],
        "sensitive": false
      },
      {
        "name": "cert_manager_version",
        "type": "string",
        "description": "Version of cert-manager from manifest",
        "used_by": ["k8s/cert-manager"],
        "sensitive": false
      },
      {
        "name": "manifest_version",
        "type": "string",
        "description": "BNK manifest version used",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "setup_complete",
        "type": "boolean",
        "description": "Flag indicating FAR setup is complete",
        "used_by": ["bnk/flo"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": ["local", "external"]
  },
  "backend": {
    "recommendations": {
      "aws": "s3",
      "azure": "azurerm",
      "gcp": "gcs",
      "on-prem": "local"
    }
  },
  "deployment": {
    "order": 32,
    "estimated_time": "2 minutes",
    "requires_user_input": true,
    "sensitive_inputs": ["service_account_key_file"]
  }
}
