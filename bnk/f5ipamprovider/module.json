{
  "module": {
    "name": "F5 IPAM Provider",
    "path": "bnk/f5ipamprovider",
    "version": "1.0.0",
    "layer": "bnk-network",
    "category": "networking",
    "description": "Creates F5IPAMProvider custom resource for IP Address Management (IPAM) with configurable IP ranges and provider types.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      {
        "module": "bnk/flo",
        "reason": "FLO provides F5IPAMProvider CRD and controller"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster (used for resource identification)",
        "source": "user",
        "example": "my-cluster"
      },
      {
        "name": "provider_name",
        "type": "string",
        "description": "Name for the IPAM provider resource",
        "source": "user",
        "example": "ipam-provider"
      },
      {
        "name": "provider_namespace",
        "type": "string",
        "description": "Namespace for IPAM provider deployment",
        "source": "user",
        "example": "f5-spk"
      },
      {
        "name": "flo_ready",
        "type": "boolean",
        "description": "Dependency flag ensuring FLO is ready",
        "source": "module",
        "from_module": "bnk/flo",
        "from_output": "flo_ready",
        "example": true
      },
      {
        "name": "ip_ranges",
        "type": "list",
        "description": "List of IP ranges for IPAM (CIDR or range format)",
        "source": "user",
        "example": ["10.0.1.0/24"]
      }
    ],
    "optional": [
      {
        "name": "provider_type",
        "type": "string",
        "description": "IPAM provider type (infoblox, f5-ipam, external)",
        "default": "f5-ipam",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "provider_ready",
        "type": "boolean",
        "description": "Flag indicating IPAM provider is configured",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "provider_name",
        "type": "string",
        "description": "Name of the created IPAM provider",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "provider_namespace",
        "type": "string",
        "description": "Namespace where provider is deployed",
        "used_by": [],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": []
  },
  "backend": {
    "recommendations": {
      "aws": "s3",
      "azure": "azurerm",
      "gcp": "gcs",
      "on-prem": "local"
    }
  },
  "deployment": {
    "order": 60,
    "estimated_time": "2 minutes",
    "requires_user_input": true,
    "sensitive_inputs": []
  }
}
