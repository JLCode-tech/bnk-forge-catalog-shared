{
  "module": {
    "name": "BNK Gateway",
    "path": "bnk/gateway",
    "version": "1.0.0",
    "layer": "bnk-gateway",
    "category": "gateway",
    "description": "Creates Kubernetes Gateway API Gateway resource with listeners for traffic management.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      {
        "module": "bnk/bnk-gatewayclass",
        "reason": "Gateway must reference a valid GatewayClass"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "gateway_name",
        "type": "string",
        "description": "Name for the Gateway resource",
        "source": "user",
        "example": "bnk-gateway",
        "default": "bnk-gateway"
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace for Gateway deployment",
        "source": "user",
        "example": "gateway-ns",
        "default": "gateway-ns"
      },
      {
        "name": "gatewayclass_name",
        "type": "string",
        "description": "Name of the GatewayClass to use",
        "source": "module",
        "from_module": "bnk/bnk-gatewayclass",
        "from_output": "gatewayclass_name",
        "default": "bnk-gatewayclass"
      },
      {
        "name": "listeners",
        "type": "list(object)",
        "description": "List of listener configurations (name, protocol, port)",
        "source": "user",
        "example": [{"name": "http", "protocol": "HTTP", "port": 80}],
        "default": [{"name": "http", "protocol": "HTTP", "port": 80, "allowed_routes": {"namespaces": {"from": "Same"}}}]
      },
      {
        "name": "gatewayclass_ready",
        "type": "boolean",
        "description": "Dependency flag ensuring GatewayClass is ready",
        "source": "module",
        "from_module": "bnk/bnk-gatewayclass",
        "from_output": "gatewayclass_ready"
      }
    ],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster",
        "default": "",
        "source": "user"
      },
      {
        "name": "service_type",
        "type": "string",
        "description": "Kubernetes service type (LoadBalancer, NodePort, ClusterIP)",
        "default": "LoadBalancer",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "gateway_name",
        "type": "string",
        "description": "Name of the created Gateway",
        "used_by": ["bnk/routes"],
        "sensitive": false
      },
      {
        "name": "gateway_ready",
        "type": "boolean",
        "description": "Flag indicating Gateway is ready",
        "used_by": ["bnk/routes"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": []
  },
  "deployment": {
    "order": 70,
    "estimated_time": "5 minutes",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
