{
  "module": {
    "name": "F5 AI Load Balancing Analyzer",
    "path": "bnk/f5biganalyzer",
    "version": "1.0.0-EA",
    "layer": "bnk-ai",
    "category": "ai-ml",
    "description": "Creates F5BigAnalyzer custom resource for AI Load Balancing with LLM workload optimization and intelligent routing algorithms (Early Access).",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      {
        "module": "bnk/flo",
        "reason": "FLO provides F5BigAnalyzer CRD and controller"
      }
    ],
    "optional": [
      {
        "module": "bnk/gateway",
        "reason": "Analyzer typically optimizes routes for Gateway",
        "provides": "Gateway resources to optimize"
      }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster (used for resource identification)",
        "source": "user",
        "example": "my-cluster"
      },
      {
        "name": "analyzer_name",
        "type": "string",
        "description": "Name for the analyzer resource",
        "source": "user",
        "example": "llm-analyzer"
      },
      {
        "name": "analyzer_namespace",
        "type": "string",
        "description": "Namespace for analyzer deployment",
        "source": "user",
        "example": "default"
      },
      {
        "name": "flo_ready",
        "type": "boolean",
        "description": "Dependency flag ensuring FLO is ready",
        "source": "module",
        "from_module": "bnk/flo",
        "from_output": "flo_ready",
        "example": true
      },
      {
        "name": "llm_workload_config",
        "type": "object",
        "description": "LLM workload configuration (model types, token limits, etc.)",
        "source": "user",
        "example": {"modelType": "gpt", "maxTokens": 4096}
      }
    ],
    "optional": [
      {
        "name": "routing_algorithm",
        "type": "string",
        "description": "AI routing algorithm (token-aware, latency-optimized, cost-optimized)",
        "default": "token-aware",
        "source": "user"
      },
      {
        "name": "enable_metrics",
        "type": "boolean",
        "description": "Enable metrics collection and export",
        "default": true,
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "analyzer_ready",
        "type": "boolean",
        "description": "Flag indicating analyzer is configured",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "analyzer_name",
        "type": "string",
        "description": "Name of the created analyzer",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "analyzer_namespace",
        "type": "string",
        "description": "Namespace where analyzer is deployed",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "metrics_endpoint",
        "type": "string",
        "description": "Metrics endpoint URL for monitoring",
        "used_by": [],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": []
  },
  "backend": {
    "recommendations": {
      "aws": "s3",
      "azure": "azurerm",
      "gcp": "gcs",
      "on-prem": "local"
    }
  },
  "deployment": {
    "order": 95,
    "estimated_time": "3 minutes",
    "requires_user_input": true,
    "sensitive_inputs": []
  }
}
