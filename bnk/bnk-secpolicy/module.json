{
  "module": {
    "name": "BNK Security Policy",
    "path": "bnk/bnk-secpolicy",
    "version": "1.0.0",
    "layer": "bnk-policy",
    "category": "policy",
    "description": "Configures BNKSecPolicy CR to attach security policies (Firewall, DDoS protection, Rate Limiting) to GatewayClass or Gateway resources. Requires FLO to be deployed first.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      {
        "module": "bnk/flo",
        "reason": "FLO must be deployed to install BNKSecPolicy CRD and manage policies"
      }
    ],
    "optional": [
      {
        "module": "bnk/gateway",
        "reason": "SecurityPolicy typically attaches to Gateway",
        "provides": "Gateway attachment point for security policies"
      }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster (used for resource identification)",
        "source": "user",
        "example": "my-cluster"
      },
      {
        "name": "policy_name",
        "type": "string",
        "description": "Name for the BNKSecPolicy resource",
        "source": "user",
        "example": "my-security-policy"
      },
      {
        "name": "policy_namespace",
        "type": "string",
        "description": "Namespace for the BNKSecPolicy",
        "source": "user",
        "example": "default"
      },
      {
        "name": "flo_ready",
        "type": "boolean",
        "description": "Dependency flag ensuring FLO is ready",
        "source": "module",
        "from_module": "bnk/flo",
        "from_output": "flo_ready"
      }
    ],
    "optional": [
      {
        "name": "enable_firewall",
        "type": "boolean",
        "description": "Enable firewall policy",
        "default": false,
        "source": "user"
      },
      {
        "name": "firewall_policy_ref",
        "type": "object",
        "description": "Reference to F5BigFwPolicy resource (name and optional namespace)",
        "default": null,
        "source": "user"
      },
      {
        "name": "enable_ddos",
        "type": "boolean",
        "description": "Enable DDoS protection",
        "default": false,
        "source": "user"
      },
      {
        "name": "ddos_global_ref",
        "type": "object",
        "description": "Reference to F5BigDdosGlobal resource (name and optional namespace)",
        "default": null,
        "source": "user"
      },
      {
        "name": "ddos_protection_mode",
        "type": "string",
        "description": "DDoS protection mode (auto, manual, off)",
        "default": "auto",
        "source": "user"
      },
      {
        "name": "enable_rate_limiting",
        "type": "boolean",
        "description": "Enable rate limiting",
        "default": false,
        "source": "user"
      },
      {
        "name": "rate_limit_config",
        "type": "object",
        "description": "Rate limiting configuration (requests_per_second, burst_size, key)",
        "default": null,
        "source": "user"
      },
      {
        "name": "allowed_source_ranges",
        "type": "list(string)",
        "description": "List of allowed source IP CIDR ranges",
        "default": [],
        "source": "user"
      },
      {
        "name": "denied_source_ranges",
        "type": "list(string)",
        "description": "List of denied source IP CIDR ranges",
        "default": [],
        "source": "user"
      },
      {
        "name": "common_labels",
        "type": "map(string)",
        "description": "Common labels to apply to all Kubernetes resources",
        "default": {},
        "source": "user"
      },
      {
        "name": "annotations",
        "type": "map(string)",
        "description": "Annotations to add to the policy resource",
        "default": {},
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "policy_name",
        "type": "string",
        "description": "Name of the created BNKSecPolicy",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "policy_namespace",
        "type": "string",
        "description": "Namespace of the BNKSecPolicy",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "policy_ready",
        "type": "boolean",
        "description": "Flag indicating policy was applied",
        "used_by": [],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": []
  },
  "deployment": {
    "order": 85,
    "estimated_time": "1 minute",
    "requires_user_input": true,
    "sensitive_inputs": []
  }
}
