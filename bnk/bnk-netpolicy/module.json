{
  "module": {
    "name": "BNK Network Policy",
    "path": "bnk/bnk-netpolicy",
    "version": "1.0.0",
    "layer": "bnk-policy",
    "category": "policy",
    "description": "Configures BNKNetPolicy CR to attach network policies (iRules, TCP settings, HSL logging, connection pooling) to Gateway resources. Requires FLO to be deployed first.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      {
        "module": "bnk/flo",
        "reason": "FLO must be deployed to install BNKNetPolicy CRD and manage policies"
      }
    ],
    "optional": [
      {
        "module": "bnk/gateway",
        "reason": "NetworkPolicy typically attaches to Gateway",
        "provides": "Gateway attachment point for network policies"
      }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster (used for resource identification)",
        "source": "user",
        "example": "my-cluster"
      },
      {
        "name": "policy_name",
        "type": "string",
        "description": "Name for the BNKNetPolicy resource",
        "source": "user",
        "example": "my-network-policy"
      },
      {
        "name": "policy_namespace",
        "type": "string",
        "description": "Namespace for the BNKNetPolicy",
        "source": "user",
        "example": "default"
      },
      {
        "name": "flo_ready",
        "type": "boolean",
        "description": "Dependency flag ensuring FLO is ready",
        "source": "module",
        "from_module": "bnk/flo",
        "from_output": "flo_ready"
      }
    ],
    "optional": [
      {
        "name": "irules",
        "type": "list(object)",
        "description": "List of iRule references (name, namespace) or inline iRule code",
        "default": [],
        "source": "user"
      },
      {
        "name": "tcp_profile",
        "type": "object",
        "description": "TCP profile configuration (idle_timeout, nagle_algorithm, etc.)",
        "default": null,
        "source": "user"
      },
      {
        "name": "tcp_settings_ref",
        "type": "object",
        "description": "Reference to existing F5 TCP settings profile (name and optional namespace)",
        "default": null,
        "source": "user"
      },
      {
        "name": "http_profile",
        "type": "object",
        "description": "HTTP profile configuration (xff, headers, chunking)",
        "default": null,
        "source": "user"
      },
      {
        "name": "hsl_logging",
        "type": "object",
        "description": "High-speed logging configuration (publisher_ref, log_profile_ref)",
        "default": null,
        "source": "user"
      },
      {
        "name": "connection_pool",
        "type": "object",
        "description": "Backend connection pooling configuration",
        "default": null,
        "source": "user"
      },
      {
        "name": "persistence",
        "type": "object",
        "description": "Session persistence configuration (cookie, source-ip, hash)",
        "default": null,
        "source": "user"
      },
      {
        "name": "ssl_profile",
        "type": "object",
        "description": "SSL/TLS profile for backend connections",
        "default": null,
        "source": "user"
      },
      {
        "name": "compression",
        "type": "object",
        "description": "HTTP compression configuration",
        "default": null,
        "source": "user"
      },
      {
        "name": "common_labels",
        "type": "map(string)",
        "description": "Common labels to apply to all Kubernetes resources",
        "default": {},
        "source": "user"
      },
      {
        "name": "annotations",
        "type": "map(string)",
        "description": "Annotations to add to the policy resource",
        "default": {},
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "policy_name",
        "type": "string",
        "description": "Name of the created BNKNetPolicy",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "policy_namespace",
        "type": "string",
        "description": "Namespace of the BNKNetPolicy",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "policy_ready",
        "type": "boolean",
        "description": "Flag indicating policy was applied",
        "used_by": [],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": []
  },
  "deployment": {
    "order": 86,
    "estimated_time": "1 minute",
    "requires_user_input": true,
    "sensitive_inputs": []
  }
}
