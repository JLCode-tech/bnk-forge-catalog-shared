{
  "schema_version": 1,
  "module": {
    "name": "BNK Network Policy",
    "path": "bnk/bnk-netpolicy",
    "version": "2.0.0",
    "category": "bnk",
    "description": "Creates a BNKNetPolicy resource with optional iRules, TCP/HTTP tuning, logging, pooling, persistence, SSL, and compression settings."
  },
  "deployment_pack": {
    "engine": "kubernetes",
    "runner_profile": "kubernetes-default",
    "working_directory": ".",
    "template_engine": "jinja2",
    "lifecycle": {
      "supports_init": false,
      "supports_plan": false,
      "supports_apply": true,
      "supports_destroy": true,
      "supports_refresh": false,
      "supports_drift": false
    },
    "entrypoints": {
      "manifest_path": "manifests/"
    }
  },
  "dependencies": {
    "required": [
      {
        "module": "bnk/flo",
        "reason": "FLO must be deployed to install BNKNetPolicy CRD and manage policy resources"
      }
    ],
    "optional": [
      {
        "module": "bnk/gateway",
        "reason": "BNKNetPolicy commonly attaches policy behavior to gateway traffic"
      }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster",
        "source": "user"
      },
      {
        "name": "policy_name",
        "type": "string",
        "description": "Name of the BNKNetPolicy resource",
        "source": "user"
      },
      {
        "name": "policy_namespace",
        "type": "string",
        "description": "Namespace where policy will be deployed",
        "source": "user"
      },
      {
        "name": "flo_ready",
        "type": "boolean",
        "description": "Dependency flag indicating FLO is ready and CRDs are installed",
        "source": "module",
        "from_module": "bnk/flo",
        "from_output": "flo_ready"
      }
    ],
    "optional": [
      {
        "name": "irules",
        "type": "list(object)",
        "description": "List of iRule references or inline iRule definitions",
        "default": [],
        "source": "user"
      },
      {
        "name": "tcp_profile",
        "type": "object",
        "description": "Inline TCP profile configuration",
        "default": null,
        "source": "user"
      },
      {
        "name": "tcp_settings_ref",
        "type": "object",
        "description": "Reference to existing F5 TCP settings profile",
        "default": null,
        "source": "user"
      },
      {
        "name": "http_profile",
        "type": "object",
        "description": "HTTP profile configuration",
        "default": null,
        "source": "user"
      },
      {
        "name": "hsl_logging",
        "type": "object",
        "description": "High-speed logging configuration",
        "default": null,
        "source": "user"
      },
      {
        "name": "connection_pool",
        "type": "object",
        "description": "Backend connection pooling configuration",
        "default": null,
        "source": "user"
      },
      {
        "name": "persistence",
        "type": "object",
        "description": "Session persistence configuration",
        "default": null,
        "source": "user"
      },
      {
        "name": "ssl_profile",
        "type": "object",
        "description": "SSL/TLS profile configuration for backend connections",
        "default": null,
        "source": "user"
      },
      {
        "name": "compression",
        "type": "object",
        "description": "HTTP compression configuration",
        "default": null,
        "source": "user"
      },
      {
        "name": "common_labels",
        "type": "map(string)",
        "description": "Common labels to apply to the policy resource",
        "default": {},
        "source": "user"
      },
      {
        "name": "annotations",
        "type": "map(string)",
        "description": "Annotations to add to the policy resource",
        "default": {},
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "policy_name",
        "type": "string",
        "description": "Name of the created BNKNetPolicy"
      },
      {
        "name": "policy_namespace",
        "type": "string",
        "description": "Namespace of the BNKNetPolicy"
      },
      {
        "name": "policy_ready",
        "type": "boolean",
        "description": "Flag indicating policy was applied"
      },
      {
        "name": "irules_count",
        "type": "number",
        "description": "Number of iRules configured"
      },
      {
        "name": "tcp_profile_configured",
        "type": "boolean",
        "description": "Whether TCP profile is configured"
      },
      {
        "name": "http_profile_configured",
        "type": "boolean",
        "description": "Whether HTTP profile is configured"
      },
      {
        "name": "logging_enabled",
        "type": "boolean",
        "description": "Whether HSL logging is enabled"
      }
    ]
  }
}
