{
  "module": {
    "name": "CNE Instance Configuration",
    "path": "bnk/cneinstance",
    "version": "1.0.0",
    "layer": "bnk-system",
    "category": "system",
    "description": "Creates CneInstance custom resource for CNE (Container Networking and Execution) instance configuration with resource limits and instance settings.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      {
        "module": "bnk/flo",
        "reason": "FLO provides CneInstance CRD and controller"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster (used for resource identification)",
        "source": "user",
        "example": "my-cluster"
      },
      {
        "name": "instance_name",
        "type": "string",
        "description": "Name for the CNE instance resource",
        "source": "user",
        "example": "cne-instance-1"
      },
      {
        "name": "instance_namespace",
        "type": "string",
        "description": "Namespace for CNE instance deployment",
        "source": "user",
        "example": "f5-spk"
      },
      {
        "name": "flo_ready",
        "type": "boolean",
        "description": "Dependency flag ensuring FLO is ready",
        "source": "module",
        "from_module": "bnk/flo",
        "from_output": "flo_ready",
        "example": true
      },
      {
        "name": "instance_config",
        "type": "object",
        "description": "CNE instance configuration settings",
        "source": "user",
        "example": {"instanceType": "standard"}
      }
    ],
    "optional": [
      {
        "name": "resource_limits",
        "type": "object",
        "description": "Resource limits for CNE instance",
        "default": {},
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "instance_ready",
        "type": "boolean",
        "description": "Flag indicating CNE instance is configured",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "instance_name",
        "type": "string",
        "description": "Name of the created CNE instance",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "instance_namespace",
        "type": "string",
        "description": "Namespace where instance is deployed",
        "used_by": [],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": []
  },
  "backend": {
    "recommendations": {
      "aws": "s3",
      "azure": "azurerm",
      "gcp": "gcs",
      "on-prem": "local"
    }
  },
  "deployment": {
    "order": 55,
    "estimated_time": "2 minutes",
    "requires_user_input": true,
    "sensitive_inputs": []
  }
}
