{
  "module": {
    "name": "F5 HSL Publisher",
    "path": "bnk/f5bigloghslpub",
    "version": "1.0.0",
    "layer": "bnk-logging",
    "category": "logging",
    "description": "Creates F5BigLogHslpub custom resource for High-Speed Logging (HSL) publisher configuration with remote syslog servers.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      {
        "module": "bnk/flo",
        "reason": "FLO provides F5BigLogHslpub CRD and controller"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster (used for resource identification)",
        "source": "user",
        "example": "my-cluster"
      },
      {
        "name": "publisher_name",
        "type": "string",
        "description": "Name for the HSL publisher resource",
        "source": "user",
        "example": "remote-syslog"
      },
      {
        "name": "publisher_namespace",
        "type": "string",
        "description": "Namespace for HSL publisher deployment",
        "source": "user",
        "example": "default"
      },
      {
        "name": "flo_ready",
        "type": "boolean",
        "description": "Dependency flag ensuring FLO is ready",
        "source": "module",
        "from_module": "bnk/flo",
        "from_output": "flo_ready",
        "example": true
      },
      {
        "name": "syslog_servers",
        "type": "list",
        "description": "List of syslog server addresses",
        "source": "user",
        "example": ["syslog.example.com:514"]
      }
    ],
    "optional": [
      {
        "name": "protocol",
        "type": "string",
        "description": "Protocol for syslog (tcp or udp)",
        "default": "tcp",
        "source": "user"
      },
      {
        "name": "port",
        "type": "number",
        "description": "Default syslog port",
        "default": 514,
        "source": "user"
      },
      {
        "name": "pool_name",
        "type": "string",
        "description": "Server pool name for load balancing",
        "default": null,
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "publisher_ready",
        "type": "boolean",
        "description": "Flag indicating HSL publisher is configured",
        "used_by": ["bnk/bnk-secpolicy"],
        "sensitive": false
      },
      {
        "name": "publisher_name",
        "type": "string",
        "description": "Name of the created publisher",
        "used_by": ["bnk/bnk-secpolicy"],
        "sensitive": false
      },
      {
        "name": "publisher_namespace",
        "type": "string",
        "description": "Namespace where publisher is deployed",
        "used_by": [],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": []
  },
  "backend": {
    "recommendations": {
      "aws": "s3",
      "azure": "azurerm",
      "gcp": "gcs",
      "on-prem": "local"
    }
  },
  "deployment": {
    "order": 70,
    "estimated_time": "2 minutes",
    "requires_user_input": true,
    "sensitive_inputs": []
  }
}
