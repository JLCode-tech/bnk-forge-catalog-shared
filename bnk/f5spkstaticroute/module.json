{
  "module": {
    "name": "F5 SPK Static Route",
    "path": "bnk/f5spkstaticroute",
    "version": "1.0.0",
    "layer": "bnk-network",
    "category": "networking",
    "description": "Creates F5SPKStaticRoute custom resource for configuring static routes with destination networks, gateways, and interfaces.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      {
        "module": "bnk/flo",
        "reason": "FLO provides F5SPKStaticRoute CRD and controller"
      }
    ],
    "optional": [
      {
        "module": "bnk/f5spkvlan",
        "reason": "Static routes may reference VLAN interfaces",
        "provides": "VLAN resources that routes can use"
      }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster (used for resource identification)",
        "source": "user",
        "example": "my-cluster"
      },
      {
        "name": "route_name",
        "type": "string",
        "description": "Name for the static route resource",
        "source": "user",
        "example": "default-route"
      },
      {
        "name": "route_namespace",
        "type": "string",
        "description": "Namespace for static route deployment",
        "source": "user",
        "example": "f5-spk"
      },
      {
        "name": "flo_ready",
        "type": "boolean",
        "description": "Dependency flag ensuring FLO is ready",
        "source": "module",
        "from_module": "bnk/flo",
        "from_output": "flo_ready",
        "example": true
      },
      {
        "name": "destination",
        "type": "string",
        "description": "Destination network in CIDR notation",
        "source": "user",
        "example": "0.0.0.0/0"
      },
      {
        "name": "gateway",
        "type": "string",
        "description": "Gateway IP address",
        "source": "user",
        "example": "172.16.100.1"
      }
    ],
    "optional": [
      {
        "name": "interface",
        "type": "string",
        "description": "Network interface for the route",
        "default": null,
        "source": "user"
      },
      {
        "name": "metric",
        "type": "number",
        "description": "Route metric/priority",
        "default": 1,
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "route_ready",
        "type": "boolean",
        "description": "Flag indicating static route is configured",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "route_name",
        "type": "string",
        "description": "Name of the created static route",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "route_namespace",
        "type": "string",
        "description": "Namespace where route is deployed",
        "used_by": [],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": []
  },
  "backend": {
    "recommendations": {
      "aws": "s3",
      "azure": "azurerm",
      "gcp": "gcs",
      "on-prem": "local"
    }
  },
  "deployment": {
    "order": 65,
    "estimated_time": "1 minute",
    "requires_user_input": true,
    "sensitive_inputs": []
  }
}
