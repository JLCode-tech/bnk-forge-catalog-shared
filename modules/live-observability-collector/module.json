{
  "module": {
    "name": "Live Observability Collector",
    "path": "modules/live-observability-collector",
    "version": "0.1.0-alpha",
    "layer": "kubernetes",
    "category": "k8s",
    "description": "Cloud-agnostic primitive: Fluent Bit DaemonSet for live BNK observability. Tails pod logs, parses JSON, promotes model/status/job labels, forwards to Loki. Real live collection, not a generator.",
    "cloud_specific": false,
    "supported_platforms": [
      "any"
    ]
  },
  "source": {
    "kind": "official",
    "channel": "release/2.3"
  },
  "execution": {
    "engine": "opentofu",
    "deploy_models": [
      "kubernetes_manifest"
    ]
  },
  "contract": {
    "metadata_version": "module-metadata/v2alpha1"
  },
  "dependencies": {
    "required": [
      {
        "module": "modules/live-observability-namespace",
        "reason": "Namespace must exist before RBAC and DaemonSet resources."
      },
      {
        "module": "modules/live-observability-loki",
        "reason": "Loki service name and port must be known to configure Fluent Bit output."
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [],
    "optional": [
      {
        "name": "observability_namespace",
        "type": "string",
        "description": "Namespace for Fluent Bit resources.",
        "default": "llm-egress",
        "source": "module",
        "from_module": "modules/live-observability-namespace",
        "from_output": "observability_namespace"
      },
      {
        "name": "loki_service_name",
        "type": "string",
        "description": "Loki Kubernetes Service name. Used as the Host component for the Fluent Bit Loki output plugin.",
        "default": "loki",
        "source": "module",
        "from_module": "modules/live-observability-loki",
        "from_output": "loki_service_name"
      },
      {
        "name": "loki_port",
        "type": "number",
        "description": "Loki HTTP API port. Used as the Port for the Fluent Bit Loki output plugin.",
        "default": 3100,
        "source": "module",
        "from_module": "modules/live-observability-loki",
        "from_output": "loki_port"
      },
      {
        "name": "enable_pod_log_collection",
        "type": "boolean",
        "description": "Deploy Fluent Bit DaemonSet.",
        "default": true,
        "source": "user"
      },
      {
        "name": "fluent_bit_version",
        "type": "string",
        "description": "Fluent Bit image tag.",
        "default": "3.1.9",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "collector_installed",
        "type": "boolean",
        "description": "Whether Fluent Bit DaemonSet was deployed.",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "collector_ready",
        "type": "boolean",
        "description": "Gate: DaemonSet rolled out.",
        "used_by": ["live-observability-readiness"],
        "sensitive": false
      }
    ]
  },
  "deployment": {
    "order": 30,
    "estimated_time": "2 minutes",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
