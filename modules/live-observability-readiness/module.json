{
  "module": {
    "name": "Live Observability Readiness",
    "path": "modules/live-observability-readiness",
    "version": "0.1.0-alpha",
    "layer": "kubernetes",
    "category": "k8s",
    "description": "Cloud-agnostic gate: verify Loki /ready via K8s API-server service proxy before marking observability stack available.",
    "cloud_specific": false,
    "supported_platforms": [
      "any"
    ]
  },
  "source": {
    "kind": "official",
    "channel": "release/2.3"
  },
  "execution": {
    "engine": "opentofu",
    "deploy_models": [
      "kubernetes_manifest"
    ]
  },
  "contract": {
    "metadata_version": "module-metadata/v2alpha1"
  },
  "dependencies": {
    "required": [
      {
        "module": "modules/live-observability-loki",
        "reason": "Loki must be deployed before readiness check."
      },
      {
        "module": "modules/live-observability-collector",
        "reason": "Collector must be deployed before stack readiness is confirmed."
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [],
    "optional": [
      {
        "name": "observability_namespace",
        "type": "string",
        "description": "Namespace where Loki is running.",
        "default": "llm-egress",
        "source": "module",
        "from_module": "modules/live-observability-namespace",
        "from_output": "observability_namespace"
      },
      {
        "name": "loki_service_name",
        "type": "string",
        "description": "Loki service name.",
        "default": "loki",
        "source": "module",
        "from_module": "modules/live-observability-loki",
        "from_output": "loki_service_name"
      },
      {
        "name": "loki_port",
        "type": "number",
        "description": "Loki HTTP port.",
        "default": 3100,
        "source": "user"
      },
      {
        "name": "readiness_timeout_seconds",
        "type": "number",
        "description": "Seconds to wait for Loki /ready.",
        "default": 120,
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "observability_ready",
        "type": "boolean",
        "description": "Loki returned /ready 200 via K8s API-server proxy.",
        "used_by": ["traffic-producing blueprints"],
        "sensitive": false
      },
      {
        "name": "loki_proxy_url",
        "type": "string",
        "description": "K8s API-server proxy path used for readiness check.",
        "used_by": [],
        "sensitive": false
      }
    ]
  },
  "deployment": {
    "order": 40,
    "estimated_time": "2 minutes",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
