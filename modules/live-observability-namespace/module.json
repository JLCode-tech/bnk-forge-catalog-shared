{
  "module": {
    "name": "Live Observability Namespace",
    "path": "modules/live-observability-namespace",
    "version": "0.1.0-alpha",
    "layer": "kubernetes",
    "category": "k8s",
    "description": "Cloud-agnostic primitive: create and label a Kubernetes namespace for BNK live observability. Default 'llm-egress' matches Forge AI Gateway defaults.",
    "cloud_specific": false,
    "supported_platforms": [
      "any"
    ]
  },
  "source": {
    "kind": "official",
    "channel": "release/2.3"
  },
  "execution": {
    "engine": "opentofu",
    "deploy_models": [
      "kubernetes_manifest"
    ]
  },
  "contract": {
    "metadata_version": "module-metadata/v2alpha1"
  },
  "dependencies": {
    "required": [],
    "optional": []
  },
  "inputs": {
    "required": [],
    "optional": [
      {
        "name": "observability_namespace",
        "type": "string",
        "description": "Namespace to create for live observability components.",
        "default": "llm-egress",
        "source": "user"
      },
      {
        "name": "poc_label",
        "type": "string",
        "description": "Value for bnk-forge/poc label on the namespace.",
        "default": "default",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "observability_namespace",
        "type": "string",
        "description": "Created namespace name.",
        "used_by": ["live-observability-loki", "live-observability-collector", "live-observability-readiness"],
        "sensitive": false
      },
      {
        "name": "namespace_ready",
        "type": "boolean",
        "description": "Gate: namespace is Active.",
        "used_by": ["live-observability-loki"],
        "sensitive": false
      }
    ]
  },
  "deployment": {
    "order": 10,
    "estimated_time": "30 seconds",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
