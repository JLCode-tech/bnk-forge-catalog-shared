{
  "module": {
    "name": "Live Observability Loki",
    "path": "modules/live-observability-loki",
    "version": "0.1.0-alpha",
    "layer": "kubernetes",
    "category": "k8s",
    "description": "Cloud-agnostic primitive: deploy Grafana Loki as plain Kubernetes manifests for BNK live observability. No Helm. Single-replica, emptyDir, PoC retention. Service name/port match Forge AI Gateway defaults.",
    "cloud_specific": false,
    "supported_platforms": [
      "any"
    ]
  },
  "source": {
    "kind": "official",
    "channel": "release/2.3"
  },
  "execution": {
    "engine": "opentofu",
    "deploy_models": [
      "kubernetes_manifest"
    ]
  },
  "contract": {
    "metadata_version": "module-metadata/v2alpha1"
  },
  "dependencies": {
    "required": [
      {
        "module": "modules/live-observability-namespace",
        "reason": "Namespace must exist before Loki resources are created."
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [],
    "optional": [
      {
        "name": "observability_namespace",
        "type": "string",
        "description": "Namespace where Loki is deployed.",
        "default": "llm-egress",
        "source": "module",
        "from_module": "modules/live-observability-namespace",
        "from_output": "observability_namespace"
      },
      {
        "name": "loki_service_name",
        "type": "string",
        "description": "Kubernetes Service name for Loki.",
        "default": "loki",
        "source": "user"
      },
      {
        "name": "loki_port",
        "type": "number",
        "description": "Loki HTTP API port.",
        "default": 3100,
        "source": "user"
      },
      {
        "name": "loki_retention_hours",
        "type": "number",
        "description": "Chunk/index retention in hours.",
        "default": 24,
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "loki_endpoint",
        "type": "string",
        "description": "In-cluster push URL for Loki (documentation; downstream modules use service name/port separately).",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "loki_service_name",
        "type": "string",
        "description": "Resolved Loki service name.",
        "used_by": ["live-observability-collector", "live-observability-readiness"],
        "sensitive": false
      },
      {
        "name": "loki_port",
        "type": "string",
        "description": "Resolved Loki HTTP port.",
        "used_by": ["live-observability-collector", "live-observability-readiness"],
        "sensitive": false
      },
      {
        "name": "loki_namespace",
        "type": "string",
        "description": "Namespace where Loki is deployed.",
        "used_by": ["live-observability-collector"],
        "sensitive": false
      },
      {
        "name": "loki_ready",
        "type": "boolean",
        "description": "Gate: Loki manifests applied and Deployment rolled out.",
        "used_by": ["live-observability-collector"],
        "sensitive": false
      }
    ]
  },
  "deployment": {
    "order": 20,
    "estimated_time": "2 minutes",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
