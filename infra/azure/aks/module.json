{
  "module": {
    "name": "Azure AKS Cluster",
    "path": "infra/azure/aks",
    "version": "1.0.0",
    "layer": "infrastructure",
    "category": "compute",
    "description": "Creates Azure AKS cluster with managed node pools and networking.",
    "cloud_specific": true,
    "supported_platforms": ["azure"]
  },
  "dependencies": {
    "required": [],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "resource_group_name",
        "type": "string",
        "description": "Azure resource group name",
        "source": "user"
      },
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name for the AKS cluster",
        "source": "user"
      },
      {
        "name": "location",
        "type": "string",
        "description": "Azure region for the cluster",
        "source": "user"
      }
    ],
    "optional": [
      {
        "name": "kubernetes_version",
        "type": "string",
        "description": "Kubernetes version",
        "default": "1.29",
        "source": "user"
      },
      {
        "name": "node_count",
        "type": "number",
        "description": "Number of nodes in the default pool",
        "default": 2,
        "source": "user"
      },
      {
        "name": "vm_size",
        "type": "string",
        "description": "Azure VM size for worker nodes",
        "default": "Standard_D4s_v3",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "kubeconfig_content",
        "type": "string",
        "description": "Kubeconfig for the AKS cluster",
        "sensitive": true
      },
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the AKS cluster"
      },
      {
        "name": "cluster_endpoint",
        "type": "string",
        "description": "Kubernetes API server endpoint"
      },
      {
        "name": "resource_group_name",
        "type": "string",
        "description": "Resource group containing the cluster"
      }
    ]
  },
  "providers": {
    "required": ["azurerm"],
    "optional": ["kubernetes", "helm"]
  },
  "deployment": {
    "order": 1,
    "estimated_time": "10 minutes",
    "requires_user_input": true,
    "sensitive_inputs": []
  }
}
