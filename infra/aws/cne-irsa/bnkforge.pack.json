{
  "schema_version": 1,
  "module": {
    "name": "AWS CNE Controller IRSA",
    "path": "infra/aws/cne-irsa",
    "version": "0.1.0",
    "category": "infra",
    "description": "IRSA + allow-ec2-vip IAM policy for the F5 CNE controller's ServiceAccount. Required when bnk/cneinstance.tmm_data_plane_mode = \"kernel\" so the controller can attach Gateway VIPs and F5SPKVlan selfips as secondary IPs on the dedicated ENIs."
  },
  "deployment_pack": {
    "engine": "opentofu",
    "runner_profile": "opentofu-default",
    "working_directory": ".",
    "lifecycle": {
      "supports_init": true,
      "supports_plan": true,
      "supports_apply": true,
      "supports_destroy": true,
      "supports_refresh": true,
      "supports_drift": true
    },
    "entrypoints": {
      "module_root": "."
    }
  },
  "dependencies": {
    "required": [
      {
        "module": "infra/aws/eks",
        "reason": "Cluster name + OIDC provider ARN/URL"
      },
      {
        "module": "bnk/cneinstance",
        "reason": "FLO creates the CNE controller SA when CNEInstance is reconciled; this module annotates it"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "EKS cluster name",
        "source": "module",
        "from_module": "infra/aws/eks",
        "from_output": "cluster_name"
      },
      {
        "name": "oidc_provider_arn",
        "type": "string",
        "description": "ARN of the cluster's IAM OIDC provider",
        "source": "module",
        "from_module": "infra/aws/eks",
        "from_output": "oidc_provider_arn"
      },
      {
        "name": "oidc_provider_url",
        "type": "string",
        "description": "URL of the cluster's IAM OIDC provider",
        "source": "module",
        "from_module": "infra/aws/eks",
        "from_output": "oidc_provider_url"
      }
    ],
    "optional": [
      {
        "name": "cne_controller_namespace",
        "type": "string",
        "description": "Namespace where the CNE controller runs",
        "default": "f5-operator",
        "source": "module",
        "from_module": "bnk/cneinstance",
        "from_output": "instance_namespace"
      },
      {
        "name": "cne_controller_sa_name",
        "type": "string",
        "description": "CNE controller ServiceAccount name",
        "default": "f5-cne-controller-default-f5-cne-controller-serviceaccount",
        "source": "user"
      },
      {
        "name": "cne_controller_deployment_name",
        "type": "string",
        "description": "CNE controller Deployment name (rollout-restart target)",
        "default": "f5-cne-controller",
        "source": "user"
      },
      {
        "name": "role_name",
        "type": "string",
        "description": "IAM role name (defaults to <cluster>-cne-controller-vip)",
        "default": "",
        "source": "user"
      },
      {
        "name": "policy_name",
        "type": "string",
        "description": "IAM policy name (defaults to <cluster>-allow-ec2-vip)",
        "default": "",
        "source": "user"
      },
      {
        "name": "cneinstance_ready",
        "type": "boolean",
        "description": "Gate from bnk/cneinstance — ensures FLO has created the controller SA before annotation",
        "default": true,
        "source": "module",
        "from_module": "bnk/cneinstance",
        "from_output": "instance_ready"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "role_arn",
        "type": "string",
        "description": "ARN of the IAM role bound to the CNE controller SA",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "ready",
        "type": "boolean",
        "description": "Set after the SA is annotated and controller restarted",
        "used_by": ["bnk/gateway", "bnk/bnk-vlans"],
        "sensitive": false
      }
    ]
  }
}
