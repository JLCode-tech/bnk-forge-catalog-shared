# infrastructure-modules/foundation/security/versions.tf
# Provider requirements for security module

terraform {
  required_version = ">= 1.0"

  # Add this backend block for Terragrunt
  backend "s3" {}

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.0"
    }
  }
}