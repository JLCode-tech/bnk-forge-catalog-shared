{
  "module": {
    "name": "AI LLM Proxy (Bedrock)",
    "path": "demo-ai-proxy",
    "version": "1.0.0",
    "layer": "app-workload",
    "category": "ai",
    "description": "Deploys LiteLLM (OpenAI-compatible proxy to AWS Bedrock) with Prometheus metrics and an AI HTTPRoute on the smart listener. Uses IRSA for Bedrock authentication — no API keys needed.",
    "cloud_specific": true,
    "supported_platforms": ["aws"]
  },
  "dependencies": {
    "required": [
      { "module": "app/demo-namespace", "reason": "Namespaces must exist before deploying AI proxy" },
      { "module": "app/demo-gateway", "reason": "Gateway must exist for AI HTTPRoute" }
    ],
    "optional": [
      { "module": "app/demo-observability", "reason": "Observability stack receives HSL logs from AI iRules" }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "app_namespace",
        "type": "string",
        "description": "Namespace for AI proxy deployment",
        "source": "module",
        "from_module": "app/demo-namespace",
        "from_output": "app_namespace"
      },
      {
        "name": "namespaces_ready",
        "type": "boolean",
        "description": "Flag indicating namespaces are ready",
        "source": "module",
        "from_module": "app/demo-namespace",
        "from_output": "namespaces_ready"
      },
      {
        "name": "gateway_name",
        "type": "string",
        "description": "Name of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_name"
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_namespace"
      },
      {
        "name": "gateway_ready",
        "type": "boolean",
        "description": "Flag indicating Gateway is ready",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_ready"
      }
    ],
    "optional": [
      { "name": "cluster_name", "type": "string", "description": "Kubernetes cluster name", "source": "auto", "from_module": "infra/aws/eks", "from_output": "cluster_name", "default": "" },
      { "name": "aws_region", "type": "string", "description": "AWS region for Bedrock", "source": "user", "default": "ap-southeast-2" },
      { "name": "bedrock_smart_model_id", "type": "string", "description": "Bedrock model ID for smart/complex tier", "source": "user", "default": "anthropic.claude-sonnet-4-20250514-v1:0" },
      { "name": "bedrock_fast_model_id", "type": "string", "description": "Bedrock model ID for fast/cheap tier", "source": "user", "default": "amazon.nova-micro-v1:0" },
      { "name": "bedrock_iam_role_arn", "type": "string", "description": "IAM Role ARN for IRSA Bedrock access", "source": "user", "default": "" },
      { "name": "litellm_replicas", "type": "number", "description": "LiteLLM proxy replicas", "source": "user", "default": 2 },
      { "name": "litellm_image", "type": "string", "description": "LiteLLM container image", "source": "user", "default": "litellm/litellm:v1.81.3-stable" },
      { "name": "enable_ai_route", "type": "boolean", "description": "Create AI HTTPRoute on smart listener", "source": "user", "default": true }
    ]
  },
  "outputs": {
    "key_outputs": [
      { "name": "litellm_service_name", "type": "string", "used_by": ["app/demo-ai-analyzer"] },
      { "name": "litellm_service_port", "type": "number", "used_by": ["app/demo-ai-analyzer"] },
      { "name": "prometheus_service_name", "type": "string", "used_by": ["app/demo-ai-analyzer"] },
      { "name": "prometheus_endpoint", "type": "string", "used_by": ["app/demo-ai-analyzer"] },
      { "name": "ai_route_name", "type": "string" },
      { "name": "ai_proxy_ready", "type": "boolean", "used_by": ["app/demo-ai-analyzer"] }
    ]
  },
  "providers": {
    "required": ["kubernetes"]
  },
  "deployment": {
    "order": 98,
    "estimated_time": "2 minutes"
  }
}
