{
  "schema_version": 1,
  "module": {
    "name": "AI LLM Proxy (Bedrock)",
    "path": "app/demo-ai-proxy",
    "version": "1.0.0",
    "category": "app",
    "description": "Deploys LiteLLM (OpenAI-compatible proxy to AWS Bedrock) with Prometheus metrics and an AI HTTPRoute on the smart listener. Uses IRSA for Bedrock authentication — no API keys needed."
  },
  "deployment_pack": {
    "engine": "kubernetes",
    "runner_profile": "kubernetes-default",
    "working_directory": ".",
    "template_engine": "jinja2",
    "lifecycle": {
      "supports_init": false,
      "supports_plan": false,
      "supports_apply": true,
      "supports_destroy": true,
      "supports_refresh": false,
      "supports_drift": false
    },
    "entrypoints": {
      "manifest_path": "manifests/"
    }
  },
  "dependencies": {
    "required": [
      {
        "module": "app/demo-namespace",
        "reason": "Namespaces must exist before deploying AI proxy"
      },
      {
        "module": "app/demo-gateway",
        "reason": "Gateway must exist for AI HTTPRoute"
      }
    ],
    "optional": [
      {
        "module": "app/demo-observability",
        "reason": "Observability stack receives HSL logs from AI iRules"
      }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "app_namespace",
        "type": "string",
        "description": "Namespace for AI proxy deployment",
        "source": "module",
        "from_module": "app/demo-namespace",
        "from_output": "app_namespace"
      },
      {
        "name": "namespaces_ready",
        "type": "boolean",
        "description": "Flag indicating namespaces are ready",
        "source": "module",
        "from_module": "app/demo-namespace",
        "from_output": "namespaces_ready"
      },
      {
        "name": "gateway_name",
        "type": "string",
        "description": "Name of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_name"
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_namespace"
      },
      {
        "name": "gateway_ready",
        "type": "boolean",
        "description": "Flag indicating Gateway is ready",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_ready"
      }
    ],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Kubernetes cluster name",
        "source": "auto",
        "from_module": "infra/aws/eks",
        "from_output": "cluster_name",
        "default": ""
      },
      {
        "name": "aws_region",
        "type": "string",
        "description": "AWS region for Bedrock",
        "source": "user",
        "default": "ap-southeast-2"
      },
      {
        "name": "bedrock_smart_model_id",
        "type": "string",
        "description": "Bedrock model ID for smart/complex tier",
        "source": "user",
        "default": "anthropic.claude-sonnet-4-20250514-v1:0"
      },
      {
        "name": "bedrock_fast_model_id",
        "type": "string",
        "description": "Bedrock model ID for fast/cheap tier",
        "source": "user",
        "default": "amazon.nova-micro-v1:0"
      },
      {
        "name": "bedrock_iam_role_arn",
        "type": "string",
        "description": "IAM Role ARN for IRSA Bedrock access",
        "source": "user",
        "default": ""
      },
      {
        "name": "litellm_replicas",
        "type": "number",
        "description": "LiteLLM proxy replicas",
        "source": "user",
        "default": 2
      },
      {
        "name": "litellm_image",
        "type": "string",
        "description": "LiteLLM container image",
        "source": "user",
        "default": "litellm/litellm:v1.81.3-stable"
      },
      {
        "name": "enable_ai_route",
        "type": "boolean",
        "description": "Create AI HTTPRoute on smart listener",
        "source": "user",
        "default": true
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "litellm_service_name",
        "type": "string",
        "description": "Name of the LiteLLM proxy service"
      },
      {
        "name": "litellm_service_port",
        "type": "number",
        "description": "Port of the LiteLLM proxy service"
      },
      {
        "name": "prometheus_service_name",
        "type": "string",
        "description": "Name of the Prometheus service"
      },
      {
        "name": "prometheus_endpoint",
        "type": "string",
        "description": "Full Prometheus endpoint URL"
      },
      {
        "name": "ai_route_name",
        "type": "string",
        "description": "Name of the AI HTTPRoute (if created)"
      },
      {
        "name": "ai_proxy_ready",
        "type": "boolean",
        "description": "Flag indicating AI proxy stack is deployed"
      }
    ]
  }
}
