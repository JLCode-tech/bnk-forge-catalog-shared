{
  "module": {
    "name": "Demo Namespaces",
    "path": "demo-namespace",
    "version": "1.0.0",
    "layer": "app-foundation",
    "category": "namespace",
    "description": "Creates isolated namespaces and cross-namespace ReferenceGrants for the BNK Demo Apps stack.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "app_namespace",
        "type": "string",
        "description": "Namespace for demo application workloads",
        "source": "user",
        "default": "demo-apps"
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace for BNK Gateway and routing resources",
        "source": "user",
        "default": "demo-gw"
      },
      {
        "name": "observability_namespace",
        "type": "string",
        "description": "Namespace for Fluent Bit and Loki observability stack",
        "source": "user",
        "default": "observability"
      }
    ],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Kubernetes cluster name (auto-wired from infra/aws/eks)",
        "source": "auto",
        "from_module": "infra/aws/eks",
        "from_output": "cluster_name",
        "default": ""
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      { "name": "app_namespace", "type": "string", "used_by": ["app/demo-apps", "app/demo-routes", "app/demo-traffic"] },
      { "name": "gateway_namespace", "type": "string", "used_by": ["app/demo-gateway", "app/demo-routes", "app/demo-security", "app/demo-irules"] },
      { "name": "observability_namespace", "type": "string", "used_by": ["app/demo-observability", "app/demo-irules"] },
      { "name": "namespaces_ready", "type": "boolean", "used_by": ["app/demo-apps", "app/demo-observability", "app/demo-gateway"] }
    ]
  },
  "providers": {
    "required": ["kubernetes"]
  },
  "deployment": {
    "order": 90,
    "estimated_time": "30 seconds"
  }
}
