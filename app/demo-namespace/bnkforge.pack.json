{
  "schema_version": 1,
  "module": {
    "name": "Demo Namespaces",
    "path": "app/demo-namespace",
    "version": "1.0.0",
    "category": "app",
    "description": "Creates demo namespaces and cross-namespace ReferenceGrants for BNK demo application traffic."
  },
  "deployment_pack": {
    "engine": "kubernetes",
    "runner_profile": "kubernetes-default",
    "working_directory": ".",
    "lifecycle": {
      "supports_init": false,
      "supports_plan": false,
      "supports_apply": true,
      "supports_destroy": true,
      "supports_refresh": false,
      "supports_drift": false
    },
    "entrypoints": {
      "manifest_path": "manifests/"
    }
  },
  "dependencies": {
    "required": [],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "app_namespace",
        "type": "string",
        "description": "Namespace for demo application workloads",
        "source": "user",
        "default": "demo-apps"
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace for BNK Gateway and routing resources",
        "source": "user",
        "default": "demo-gw"
      },
      {
        "name": "observability_namespace",
        "type": "string",
        "description": "Namespace for Fluent Bit and Loki observability stack",
        "source": "user",
        "default": "observability"
      }
    ],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Kubernetes cluster name (auto-wired from infra/aws/eks)",
        "source": "auto",
        "from_module": "infra/aws/eks",
        "from_output": "cluster_name",
        "default": ""
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "app_namespace",
        "type": "string",
        "description": "Name of the demo applications namespace",
        "used_by": [
          "app/demo-apps",
          "app/demo-routes",
          "app/demo-traffic"
        ]
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Name of the gateway namespace",
        "used_by": [
          "app/demo-gateway",
          "app/demo-routes",
          "app/demo-security",
          "app/demo-irules"
        ]
      },
      {
        "name": "observability_namespace",
        "type": "string",
        "description": "Name of the observability namespace",
        "used_by": [
          "app/demo-observability",
          "app/demo-irules"
        ]
      },
      {
        "name": "namespaces_ready",
        "type": "boolean",
        "description": "Flag indicating all namespaces and reference grants are ready",
        "used_by": [
          "app/demo-apps",
          "app/demo-observability",
          "app/demo-gateway"
        ]
      }
    ]
  }
}
