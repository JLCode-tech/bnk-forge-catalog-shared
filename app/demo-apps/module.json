{
  "module": {
    "name": "Demo Applications",
    "path": "demo-apps",
    "version": "1.0.0",
    "layer": "app-workload",
    "category": "application",
    "description": "Deploys lightweight demo applications: nginx web frontend, echo API service, and backend echo service for traffic routing demos.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      { "module": "app/demo-namespace", "reason": "Namespaces must exist before deploying workloads" }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "app_namespace",
        "type": "string",
        "description": "Namespace for demo applications",
        "source": "module",
        "from_module": "app/demo-namespace",
        "from_output": "app_namespace"
      },
      {
        "name": "namespaces_ready",
        "type": "boolean",
        "description": "Flag indicating namespaces are ready",
        "source": "module",
        "from_module": "app/demo-namespace",
        "from_output": "namespaces_ready"
      }
    ],
    "optional": [
      { "name": "cluster_name", "type": "string", "description": "Kubernetes cluster name (auto-wired from infra/aws/eks)", "source": "auto", "from_module": "infra/aws/eks", "from_output": "cluster_name", "default": "" },
      { "name": "web_replicas", "type": "number", "description": "Web frontend replicas", "source": "user", "default": 2 },
      { "name": "api_replicas", "type": "number", "description": "Echo API replicas", "source": "user", "default": 2 },
      { "name": "backend_replicas", "type": "number", "description": "Backend service replicas", "source": "user", "default": 1 }
    ]
  },
  "outputs": {
    "key_outputs": [
      { "name": "web_service_name", "type": "string", "used_by": ["app/demo-routes"] },
      { "name": "api_service_name", "type": "string", "used_by": ["app/demo-routes"] },
      { "name": "backend_service_name", "type": "string", "used_by": ["app/demo-routes"] },
      { "name": "apps_ready", "type": "boolean", "used_by": ["app/demo-traffic"] }
    ]
  },
  "providers": {
    "required": ["kubernetes"]
  },
  "deployment": {
    "order": 91,
    "estimated_time": "1 minute"
  }
}
