{
  "schema_version": 1,
  "module": {
    "name": "Demo Applications",
    "path": "app/demo-apps",
    "version": "1.0.0",
    "category": "app",
    "description": "Deploys lightweight demo applications: nginx web frontend, echo API service, and backend echo service for traffic routing demos."
  },
  "deployment_pack": {
    "engine": "kubernetes",
    "runner_profile": "kubernetes-default",
    "working_directory": ".",
    "lifecycle": {
      "supports_init": false,
      "supports_plan": false,
      "supports_apply": true,
      "supports_destroy": true,
      "supports_refresh": false,
      "supports_drift": false
    },
    "entrypoints": {
      "manifest_path": "manifests/"
    }
  },
  "dependencies": {
    "required": [
      {
        "module": "app/demo-namespace",
        "reason": "Namespaces must exist before deploying workloads"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "app_namespace",
        "type": "string",
        "description": "Namespace for demo applications",
        "source": "module",
        "from_module": "app/demo-namespace",
        "from_output": "app_namespace"
      }
    ],
    "optional": [
      {
        "name": "web_replicas",
        "type": "number",
        "description": "Web frontend replicas",
        "source": "user",
        "default": 1
      },
      {
        "name": "api_replicas",
        "type": "number",
        "description": "Echo API replicas",
        "source": "user",
        "default": 1
      },
      {
        "name": "backend_replicas",
        "type": "number",
        "description": "Backend service replicas",
        "source": "user",
        "default": 1
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "web_service_name",
        "type": "string",
        "description": "Name of the web frontend service",
        "used_by": [
          "app/demo-routes"
        ]
      },
      {
        "name": "api_service_name",
        "type": "string",
        "description": "Name of the echo API service",
        "used_by": [
          "app/demo-routes"
        ]
      },
      {
        "name": "backend_service_name",
        "type": "string",
        "description": "Name of the backend service",
        "used_by": [
          "app/demo-routes"
        ]
      },
      {
        "name": "apps_ready",
        "type": "boolean",
        "description": "Flag indicating all demo applications are deployed",
        "used_by": [
          "app/demo-traffic"
        ]
      }
    ]
  }
}
