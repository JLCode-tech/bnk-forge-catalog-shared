{
  "schema_version": 1,
  "module": {
    "name": "Demo Security Policies",
    "path": "app/demo-security",
    "version": "1.0.0",
    "category": "app",
    "description": "Creates F5BigFwPolicy with allow/deny rules, address/port lists, and BNKSecPolicy attached to the demo Gateway."
  },
  "deployment_pack": {
    "engine": "kubernetes",
    "runner_profile": "kubernetes-default",
    "working_directory": ".",
    "lifecycle": {
      "supports_init": false,
      "supports_plan": false,
      "supports_apply": true,
      "supports_destroy": true,
      "supports_refresh": false,
      "supports_drift": false
    },
    "entrypoints": {
      "manifest_path": "manifests/"
    }
  },
  "dependencies": {
    "required": [
      {
        "module": "app/demo-gateway",
        "reason": "Security policies attach to the Gateway"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "gateway_name",
        "type": "string",
        "description": "Name of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_name"
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_namespace"
      }
    ],
    "optional": []
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "fw_policy_name",
        "type": "string",
        "description": "Name of the firewall policy"
      },
      {
        "name": "secpolicy_name",
        "type": "string",
        "description": "Name of the BNK security policy"
      },
      {
        "name": "security_ready",
        "type": "boolean",
        "description": "Flag indicating security policies are deployed"
      }
    ]
  }
}
