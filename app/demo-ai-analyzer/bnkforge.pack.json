{
  "schema_version": 1,
  "module": {
    "name": "AI Intelligent Load Balancer",
    "path": "app/demo-ai-analyzer",
    "version": "2.0.0",
    "category": "app",
    "description": "Deploys F5BigAnalyzer CR with custom Bedrock-aware script that reads LiteLLM Prometheus metrics to dynamically adjust AI traffic weights. Includes optional token counting iRule."
  },
  "deployment_pack": {
    "engine": "kubernetes",
    "runner_profile": "kubernetes-default",
    "working_directory": ".",
    "template_engine": "jinja2",
    "lifecycle": {
      "supports_init": false,
      "supports_plan": false,
      "supports_apply": true,
      "supports_destroy": true,
      "supports_refresh": false,
      "supports_drift": false
    },
    "entrypoints": {
      "manifest_path": "manifests/"
    }
  },
  "dependencies": {
    "required": [
      {
        "module": "app/demo-ai-proxy",
        "reason": "AI proxy must be deployed (provides Prometheus metrics + AI HTTPRoute)"
      },
      {
        "module": "app/demo-gateway",
        "reason": "Gateway must exist for iRule attachment and Analyzer route monitoring"
      }
    ],
    "optional": [
      {
        "module": "app/demo-observability",
        "reason": "Fluent Bit receives token usage HSL logs"
      }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "gateway_name",
        "type": "string",
        "description": "Name of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_name"
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_namespace"
      },
      {
        "name": "prometheus_endpoint",
        "type": "string",
        "description": "Prometheus endpoint URL",
        "source": "module",
        "from_module": "app/demo-ai-proxy",
        "from_output": "prometheus_endpoint"
      },
      {
        "name": "ai_proxy_ready",
        "type": "boolean",
        "description": "Flag indicating AI proxy is deployed",
        "source": "module",
        "from_module": "app/demo-ai-proxy",
        "from_output": "ai_proxy_ready"
      }
    ],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Kubernetes cluster name",
        "source": "auto",
        "from_module": "infra/aws/eks",
        "from_output": "cluster_name",
        "default": ""
      },
      {
        "name": "app_namespace",
        "type": "string",
        "description": "Namespace for demo applications",
        "source": "user",
        "default": "demo-apps"
      },
      {
        "name": "observability_namespace",
        "type": "string",
        "description": "Namespace for observability stack",
        "source": "user",
        "default": "observability"
      },
      {
        "name": "fluentbit_hsl_port",
        "type": "number",
        "description": "Fluent Bit HSL receiver port for token usage logs",
        "source": "user",
        "default": 5514
      },
      {
        "name": "bedrock_smart_model_id",
        "type": "string",
        "description": "Bedrock smart model ID",
        "source": "user",
        "default": "anthropic.claude-sonnet-4-20250514-v1:0"
      },
      {
        "name": "bedrock_fast_model_id",
        "type": "string",
        "description": "Bedrock fast model ID",
        "source": "user",
        "default": "amazon.nova-micro-v1:0"
      },
      {
        "name": "analyzer_schedule",
        "type": "string",
        "description": "Analyzer run frequency",
        "source": "user",
        "default": "1m"
      },
      {
        "name": "enable_token_irule",
        "type": "boolean",
        "description": "Deploy token counting iRule",
        "source": "user",
        "default": true
      },
      {
        "name": "gateway_ready",
        "type": "boolean",
        "description": "Dependency gate from gateway module",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_ready",
        "default": true
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "analyzer_name",
        "type": "string",
        "description": "Name of the F5BigAnalyzer CR"
      },
      {
        "name": "analyzer_script_configmap",
        "type": "string",
        "description": "Name of the analyzer script ConfigMap"
      },
      {
        "name": "token_irule_name",
        "type": "string",
        "description": "Name of the token counting iRule (empty if disabled)"
      },
      {
        "name": "ai_analyzer_ready",
        "type": "boolean",
        "description": "Whether AI Analyzer is deployed"
      }
    ]
  }
}
