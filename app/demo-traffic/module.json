{
  "module": {
    "name": "Traffic Generators",
    "path": "demo-traffic",
    "version": "1.0.0",
    "layer": "app-workload",
    "category": "traffic",
    "description": "Deploys CronJob-based health checks that target backend services directly via ClusterIP. For real traffic testing through BNK Gateway, use the jumphost (curl http://VIP).",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      { "module": "app/demo-routes", "reason": "Routes must be deployed before generating traffic" }
    ],
    "optional": [
      { "module": "app/demo-gateway", "reason": "Gateway provides the traffic endpoint" },
      { "module": "app/demo-apps", "reason": "Backend services must be running to handle traffic" }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "routes_ready",
        "type": "boolean",
        "description": "Flag indicating routes are deployed",
        "source": "module",
        "from_module": "app/demo-routes",
        "from_output": "routes_ready"
      }
    ],
    "optional": [
      { "name": "cluster_name", "type": "string", "description": "Kubernetes cluster name (auto-wired from infra/aws/eks)", "source": "auto", "from_module": "infra/aws/eks", "from_output": "cluster_name", "default": "" },
      { "name": "app_namespace", "type": "string", "source": "user", "default": "demo-apps" },
      { "name": "backend_service_name", "type": "string", "description": "Backend service to health-check (demo-web always deployed)", "source": "user", "default": "demo-web" },
      { "name": "backend_service_port", "type": "number", "description": "Backend service port", "source": "user", "default": 80 },
      { "name": "enable_web_traffic", "type": "boolean", "source": "user", "default": true },
      { "name": "enable_api_traffic", "type": "boolean", "source": "user", "default": true },
      { "name": "enable_canary_traffic", "type": "boolean", "source": "user", "default": true },
      { "name": "enable_blocked_traffic", "type": "boolean", "source": "user", "default": true },
      { "name": "traffic_interval_seconds", "type": "number", "source": "user", "default": 30 },
      {
        "name": "gateway_ready",
        "type": "boolean",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_ready",
        "default": true
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      { "name": "traffic_generators_deployed", "type": "number" },
      { "name": "cronjob_names", "type": "list(string)" }
    ]
  },
  "providers": {
    "required": ["kubernetes"]
  },
  "deployment": {
    "order": 97,
    "estimated_time": "30 seconds"
  }
}
