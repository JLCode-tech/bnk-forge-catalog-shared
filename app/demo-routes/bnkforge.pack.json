{
  "schema_version": 1,
  "module": {
    "name": "Demo Routes",
    "path": "app/demo-routes",
    "version": "2.0.0",
    "category": "app",
    "description": "Creates standard and smart HTTPRoutes that attach to the demo Gateway listeners."
  },
  "deployment_pack": {
    "engine": "kubernetes",
    "runner_profile": "kubernetes-default",
    "working_directory": ".",
    "lifecycle": {
      "supports_init": false,
      "supports_plan": false,
      "supports_apply": true,
      "supports_destroy": true,
      "supports_refresh": false,
      "supports_drift": false
    },
    "entrypoints": {
      "manifest_path": "manifests/"
    }
  },
  "dependencies": {
    "required": [
      {
        "module": "app/demo-gateway",
        "reason": "Routes must attach to an existing Gateway"
      }
    ],
    "optional": [
      {
        "module": "app/demo-ai-proxy",
        "reason": "AI proxy can provide smart-route backend service"
      }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "gateway_name",
        "type": "string",
        "description": "Name of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_name"
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_namespace"
      }
    ],
    "optional": [
      {
        "name": "app_namespace",
        "type": "string",
        "description": "Namespace where backend applications are deployed",
        "source": "user",
        "default": "demo-apps"
      },
      {
        "name": "backend_service_name",
        "type": "string",
        "description": "Backend service for standard route",
        "source": "user",
        "default": "demo-web"
      },
      {
        "name": "backend_service_port",
        "type": "number",
        "description": "Backend service port for standard route",
        "source": "user",
        "default": 80
      },
      {
        "name": "smart_backend_service_name",
        "type": "string",
        "description": "Backend service for smart route",
        "source": "user",
        "default": "demo-api"
      },
      {
        "name": "smart_backend_service_port",
        "type": "number",
        "description": "Backend service port for smart route",
        "source": "user",
        "default": 8080
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "route_names",
        "type": "list(string)",
        "description": "Names of created HTTPRoute resources"
      },
      {
        "name": "routes_created",
        "type": "number",
        "description": "Number of routes created"
      },
      {
        "name": "routes_ready",
        "type": "boolean",
        "description": "Whether route resources were applied",
        "used_by": [
          "app/demo-traffic"
        ]
      }
    ]
  }
}
