{
  "module": {
    "name": "Demo Routes",
    "path": "demo-routes",
    "version": "2.0.0",
    "layer": "app-gateway",
    "category": "routing",
    "description": "Creates HTTPRoutes for standard (:80) and smart (:8080) listeners routing to LiteLLM proxy backend. Matches Lanner PoC pattern.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      { "module": "app/demo-gateway", "reason": "Routes must attach to an existing Gateway" }
    ],
    "optional": [
      { "module": "app/demo-ai-proxy", "reason": "LiteLLM proxy provides the backend service" }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "gateway_name",
        "type": "string",
        "description": "Name of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_name"
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_namespace"
      },
      {
        "name": "gateway_ready",
        "type": "boolean",
        "description": "Flag indicating Gateway is ready",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_ready"
      }
    ],
    "optional": [
      { "name": "cluster_name", "type": "string", "description": "Kubernetes cluster name", "source": "auto", "from_module": "infra/aws/eks", "from_output": "cluster_name", "default": "" },
      { "name": "app_namespace", "type": "string", "source": "user", "default": "demo-apps" },
      { "name": "backend_service_name", "type": "string", "description": "Backend service name (LiteLLM proxy)", "source": "user", "default": "litellm-proxy" },
      { "name": "backend_service_port", "type": "number", "description": "Backend service port", "source": "user", "default": 4000 },
      { "name": "enable_smart_route", "type": "boolean", "source": "user", "default": true }
    ]
  },
  "outputs": {
    "key_outputs": [
      { "name": "route_names", "type": "list(string)" },
      { "name": "routes_created", "type": "number" },
      { "name": "routes_ready", "type": "boolean", "used_by": ["app/demo-traffic"] }
    ]
  },
  "providers": {
    "required": ["kubernetes"]
  },
  "deployment": {
    "order": 94,
    "estimated_time": "30 seconds"
  }
}
