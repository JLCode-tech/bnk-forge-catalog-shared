{
  "module": {
    "name": "Observability Stack",
    "path": "demo-observability",
    "version": "1.0.0",
    "layer": "app-foundation",
    "category": "observability",
    "description": "Deploys Fluent Bit (HSL UDP receiver) and Loki (log aggregation) for BNK iRule telemetry. Pattern from lanner-bnk-poc.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "dependencies": {
    "required": [
      { "module": "app/demo-namespace", "reason": "Namespaces must exist before deploying observability" }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "observability_namespace",
        "type": "string",
        "description": "Namespace for observability components",
        "source": "module",
        "from_module": "app/demo-namespace",
        "from_output": "observability_namespace"
      },
      {
        "name": "namespaces_ready",
        "type": "boolean",
        "description": "Flag indicating namespaces are ready",
        "source": "module",
        "from_module": "app/demo-namespace",
        "from_output": "namespaces_ready"
      }
    ],
    "optional": [
      { "name": "cluster_name", "type": "string", "description": "Kubernetes cluster name (auto-wired from infra/aws/eks)", "source": "auto", "from_module": "infra/aws/eks", "from_output": "cluster_name", "default": "" },
      { "name": "loki_retention_days", "type": "number", "source": "user", "default": 7 },
      { "name": "fluentbit_hsl_port", "type": "number", "source": "user", "default": 5514 }
    ]
  },
  "outputs": {
    "key_outputs": [
      { "name": "fluentbit_service_name", "type": "string", "used_by": ["app/demo-irules"] },
      { "name": "fluentbit_hsl_port", "type": "number", "used_by": ["app/demo-irules"] },
      { "name": "loki_service_name", "type": "string" },
      { "name": "observability_ready", "type": "boolean", "used_by": ["app/demo-irules"] }
    ]
  },
  "providers": {
    "required": ["kubernetes"]
  },
  "deployment": {
    "order": 92,
    "estimated_time": "1 minute"
  }
}
