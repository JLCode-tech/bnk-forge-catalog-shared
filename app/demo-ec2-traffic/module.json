{
  "module": {
    "name": "EC2 Traffic Generator",
    "path": "app/demo-ec2-traffic",
    "version": "1.0.0",
    "layer": "application",
    "category": "app",
    "description": "EC2 instance on the external subnet (10.0.10.0/24) that generates traffic to the BNK Gateway VIP (10.0.10.100). This is the REAL external traffic path: EC2 → VIP → TMM → backend pods.",
    "cloud_specific": true,
    "supported_platforms": ["aws"]
  },
  "dependencies": {
    "required": [
      {
        "module": "infra/aws/vpc",
        "reason": "Requires external subnet ID"
      },
      {
        "module": "infra/aws/security",
        "reason": "Requires security group and key pair"
      },
      {
        "module": "app/demo-gateway",
        "reason": "Requires Gateway deployed with VIP"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "external_subnet_id",
        "type": "string",
        "description": "Subnet ID for the external data-plane subnet (10.0.10.0/24)",
        "source": "module",
        "from_module": "infra/aws/vpc",
        "from_output": "private_external_subnet_ids",
        "example": "subnet-04aaea1a84136a931"
      },
      {
        "name": "security_group_id",
        "type": "string",
        "description": "Security group ID",
        "source": "module",
        "from_module": "infra/aws/security",
        "from_output": "vpc_security_group_id",
        "example": "sg-08accf679d8cf9e35"
      },
      {
        "name": "key_pair_name",
        "type": "string",
        "description": "SSH key pair name",
        "source": "module",
        "from_module": "infra/aws/security",
        "from_output": "infrastructure_key_name",
        "example": "aws-sydney-bnk-demo-infrastructure-kp"
      }
    ],
    "optional": [
      {
        "name": "instance_type",
        "type": "string",
        "description": "EC2 instance type",
        "default": "t3.micro",
        "source": "user"
      },
      {
        "name": "vip_address",
        "type": "string",
        "description": "BNK Gateway VIP address",
        "default": "10.0.10.100",
        "source": "user"
      },
      {
        "name": "tmm_external_ip",
        "type": "string",
        "description": "TMM external self-IP for connectivity checks",
        "default": "10.0.10.240",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "instance_id",
        "type": "string",
        "description": "EC2 instance ID",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "private_ip",
        "type": "string",
        "description": "Private IP on the external subnet",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "traffic_generator_ready",
        "type": "bool",
        "description": "Flag indicating traffic generator is deployed",
        "used_by": [],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["aws"],
    "optional": []
  },
  "backend": {
    "recommendations": {
      "aws": "s3"
    }
  },
  "deployment": {
    "order": 10,
    "estimated_time": "2 minutes",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
