{
  "schema_version": 1,
  "module": {
    "name": "Demo iRules & Network Policy",
    "path": "app/demo-irules",
    "version": "2.0.0",
    "category": "app",
    "description": "Creates token-counting and SmartLLM iRules plus BNKNetPolicies bound to both demo Gateway listeners."
  },
  "deployment_pack": {
    "engine": "kubernetes",
    "runner_profile": "kubernetes-default",
    "working_directory": ".",
    "lifecycle": {
      "supports_init": false,
      "supports_plan": false,
      "supports_apply": true,
      "supports_destroy": true,
      "supports_refresh": false,
      "supports_drift": false
    },
    "entrypoints": {
      "manifest_path": "manifests/"
    }
  },
  "dependencies": {
    "required": [
      {
        "module": "app/demo-gateway",
        "reason": "Network policies attach to Gateway listeners"
      }
    ],
    "optional": [
      {
        "module": "app/demo-observability",
        "reason": "Observability stack receives iRule telemetry"
      }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "gateway_name",
        "type": "string",
        "description": "Name of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_name"
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace of the BNK Gateway",
        "source": "module",
        "from_module": "app/demo-gateway",
        "from_output": "gateway_namespace"
      }
    ],
    "optional": []
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "token_counting_irule_name",
        "type": "string",
        "description": "Name of the token-counting iRule"
      },
      {
        "name": "smartllm_routing_irule_name",
        "type": "string",
        "description": "Name of the SmartLLM routing iRule"
      },
      {
        "name": "netpolicy_names",
        "type": "list(string)",
        "description": "Names of created BNKNetPolicy resources"
      },
      {
        "name": "irules_ready",
        "type": "boolean",
        "description": "Whether iRule and policy resources were applied"
      }
    ]
  }
}
