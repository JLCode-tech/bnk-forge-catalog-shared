{
  "schema_version": 1,
  "module": {
    "name": "Demo Gateway",
    "path": "app/demo-gateway",
    "version": "2.0.0",
    "category": "app",
    "description": "Creates BNK Gateway with static VIP and both standard-http (:80) and smart-http (:8080) listeners."
  },
  "deployment_pack": {
    "engine": "kubernetes",
    "runner_profile": "kubernetes-default",
    "working_directory": ".",
    "lifecycle": {
      "supports_init": false,
      "supports_plan": false,
      "supports_apply": true,
      "supports_destroy": true,
      "supports_refresh": false,
      "supports_drift": false
    },
    "entrypoints": {
      "manifest_path": "manifests/"
    }
  },
  "dependencies": {
    "required": [
      {
        "module": "app/demo-namespace",
        "reason": "Gateway namespace must exist"
      }
    ],
    "optional": [
      {
        "module": "bnk/bnk-gatewayclass",
        "reason": "GatewayClass from BNK stack provides gatewayclass_name"
      }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace for the Gateway",
        "source": "module",
        "from_module": "app/demo-namespace",
        "from_output": "gateway_namespace"
      }
    ],
    "optional": [
      {
        "name": "gateway_name",
        "type": "string",
        "description": "Name of the BNK Gateway resource",
        "source": "user",
        "default": "demo-gw"
      },
      {
        "name": "gatewayclass_name",
        "type": "string",
        "description": "GatewayClass name used by the Gateway",
        "source": "auto",
        "from_module": "bnk/bnk-gatewayclass",
        "from_output": "gatewayclass_name",
        "default": "bnk-gatewayclass"
      },
      {
        "name": "gateway_vip",
        "type": "string",
        "description": "Static VIP address for the Gateway",
        "source": "user",
        "default": "10.0.10.100"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "gateway_name",
        "type": "string",
        "description": "Name of the created Gateway",
        "used_by": [
          "app/demo-routes",
          "app/demo-security",
          "app/demo-irules",
          "app/demo-traffic"
        ]
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace of the created Gateway",
        "used_by": [
          "app/demo-routes",
          "app/demo-security",
          "app/demo-irules",
          "app/demo-traffic"
        ]
      },
      {
        "name": "gateway_vip",
        "type": "string",
        "description": "VIP address configured on the Gateway"
      },
      {
        "name": "gateway_ready",
        "type": "boolean",
        "description": "Whether the Gateway resources were applied",
        "used_by": [
          "app/demo-routes",
          "app/demo-security",
          "app/demo-irules"
        ]
      },
      {
        "name": "listeners",
        "type": "list(string)",
        "description": "Configured Gateway listener names"
      }
    ]
  }
}
